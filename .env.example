# CocheTalk.NG Environment Variables
# Copy this file to .env and fill in the values

# Required for Clerk authentication (mobile app)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Required for AI Vehicle Clinic (api-server)
GEMINI_API_KEY=

# API Server
PORT=8080

# Optional: CORS origins for production (comma-separated)
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# Optional: API base URL for mobile app (when API is hosted remotely)
# EXPO_PUBLIC_DOMAIN=your-api-domain.com
